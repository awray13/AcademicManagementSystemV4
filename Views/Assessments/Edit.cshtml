@model AcademicManagementSystemV4.Models.Assessment

@{
    ViewData["Title"] = "Edit Assessment";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="display-4">
                        <i class="fas fa-edit text-primary me-2"></i>Edit Assessment
                    </h1>
                    <p class="lead text-muted">Update assessment details and track progress</p>
                </div>
                <div>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info me-2">
                        <i class="fas fa-eye me-1"></i>View Details
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to List
                    </a>
                </div>
            </div>

            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="card shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="card-title mb-0">
                                <i class="fas fa-tasks me-2"></i>@Model.Name
                            </h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="Edit">
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                                
                                <input type="hidden" asp-for="Id" />
                                
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Name" class="form-label fw-bold">
                                            <i class="fas fa-tag me-1"></i>Assessment Name
                                        </label>
                                        <input asp-for="Name" class="form-control" placeholder="Enter assessment name" />
                                        <span asp-validation-for="Name" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="CourseId" class="form-label fw-bold">
                                            <i class="fas fa-book me-1"></i>Course
                                        </label>
                                        <select asp-for="CourseId" class="form-select" asp-items="ViewBag.CourseId">
                                            <option value="">-- Select Course --</option>
                                        </select>
                                        <span asp-validation-for="CourseId" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Description" class="form-label fw-bold">
                                        <i class="fas fa-align-left me-1"></i>Description
                                    </label>
                                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter assessment description (optional)"></textarea>
                                    <span asp-validation-for="Description" class="text-danger small"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label asp-for="Type" class="form-label fw-bold">
                                            <i class="fas fa-list me-1"></i>Type
                                        </label>
                                        <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<AcademicManagementSystemV4.Models.AssessmentType>()">
                                            <option value="">-- Select Type --</option>
                                        </select>
                                        <span asp-validation-for="Type" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label asp-for="DueDate" class="form-label fw-bold">
                                            <i class="fas fa-calendar me-1"></i>Due Date
                                        </label>
                                        <input asp-for="DueDate" type="datetime-local" class="form-control" />
                                        <span asp-validation-for="DueDate" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label asp-for="Status" class="form-label fw-bold">
                                            <i class="fas fa-flag me-1"></i>Status
                                        </label>
                                        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<AcademicManagementSystemV4.Models.AssessmentStatus>()">
                                            <option value="">-- Select Status --</option>
                                        </select>
                                        <span asp-validation-for="Status" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="MaxPoints" class="form-label fw-bold">
                                            <i class="fas fa-star me-1"></i>Maximum Points
                                        </label>
                                        <input asp-for="MaxPoints" type="number" step="0.1" class="form-control" />
                                        <span asp-validation-for="MaxPoints" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Score" class="form-label fw-bold">
                                            <i class="fas fa-trophy me-1"></i>Score
                                        </label>
                                        <input asp-for="Score" type="number" step="0.1" class="form-control" />
                                        <span asp-validation-for="Score" class="text-danger small"></span>
                                        <div class="form-text">Leave blank if not yet graded</div>
                                    </div>
                                </div>

                                <!-- Timestamps -->
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="CreatedAt" class="form-label fw-bold">
                                            <i class="fas fa-calendar-plus me-1"></i>Created At
                                        </label>
                                        <input asp-for="CreatedAt" type="datetime-local" class="form-control" readonly />
                                        <span asp-validation-for="CreatedAt" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="UpdatedAt" class="form-label fw-bold">
                                            <i class="fas fa-calendar-check me-1"></i>Last Updated
                                        </label>
                                        <input asp-for="UpdatedAt" type="datetime-local" class="form-control" readonly />
                                        <span asp-validation-for="UpdatedAt" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                                    <a asp-action="Index" class="btn btn-outline-secondary me-md-2">
                                        <i class="fas fa-times me-1"></i>Cancel
                                    </a>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save me-1"></i>Save Changes
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
