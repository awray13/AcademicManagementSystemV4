@model IEnumerable<AcademicManagementSystemV4.Models.Assessment>

@{
    ViewData["Title"] = "Assessments";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="display-4">
                        <i class="fas fa-tasks text-primary me-2"></i>Assessments
                    </h1>
                    <p class="lead text-muted">Manage your academic assessments and track progress</p>
                </div>
                <div class="btn-group" role="group">
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i>Add Assessment
                    </a>
                    <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="fas fa-cog me-1"></i>Actions
                    </button>
                    <ul class="dropdown-menu">
                        <li>
                            <a class="dropdown-item" href="@Url.Action("ExportToCsv")">
                                <i class="fas fa-download me-2"></i>Export to CSV
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" href="@Url.Action("Debug")" target="_blank">
                                <i class="fas fa-bug me-2"></i>Debug Info
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Filters and Search -->
            <div class="card mb-4">
                <div class="card-body">
                    <form method="get" id="filterForm" class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Search:</label>
                            <input type="text" name="searchString" id="searchString" value="@ViewData["CurrentFilter"]"
                                   class="form-control" placeholder="Search assessments...">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Status:</label>
                            <select name="statusFilter" id="statusFilter" class="form-select">
                                <option value="">All Statuses</option>
                                @foreach (var status in Enum.GetValues<AcademicManagementSystemV4.Models.AssessmentStatus>())
                                {
                                    <option value="@status" selected="@(ViewData["StatusFilter"]?.ToString() == status.ToString())">
                                        @status
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Type:</label>
                            <select name="typeFilter" id="typeFilter" class="form-select">
                                <option value="">All Types</option>
                                @foreach (var type in Enum.GetValues<AcademicManagementSystemV4.Models.AssessmentType>())
                                {
                                    <option value="@type" selected="@(ViewData["TypeFilter"]?.ToString() == type.ToString())">
                                        @type
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Course:</label>
                            <select name="courseFilter" id="courseFilter" class="form-select">
                                <option value="">All Courses</option>
                                @if (ViewBag.Courses != null)
                                {
                                    @foreach (var course in (IEnumerable<SelectListItem>)ViewBag.Courses)
                                    {
                                        <option value="@course.Value" selected="@(ViewData["CourseFilter"]?.ToString() == course.Value)">
                                            @course.Text
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Sort:</label>
                            <select name="sortOrder" id="sortOrder" class="form-select">
                                <option value="" selected="@(string.IsNullOrEmpty(ViewData["CurrentSort"]?.ToString()))">Due Date (Asc)</option>
                                <option value="date_desc" selected="@(ViewData["CurrentSort"]?.ToString() == "date_desc")">Due Date (Desc)</option>
                                <option value="name" selected="@(ViewData["CurrentSort"]?.ToString() == "name")">Name (A-Z)</option>
                                <option value="name_desc" selected="@(ViewData["CurrentSort"]?.ToString() == "name_desc")">Name (Z-A)</option>
                                <option value="Status" selected="@(ViewData["CurrentSort"]?.ToString() == "Status")">Status</option>
                            </select>
                        </div>
                        <div class="col-md-1 d-flex align-items-end">
                            <button type="submit" class="btn btn-outline-primary w-100">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                        
                        <!-- Hidden field for showOverdueOnly -->
                        <input type="hidden" name="showOverdueOnly" id="showOverdueOnlyHidden" value="@(ViewData["ShowOverdueOnly"]?.ToString() == "True" ? "true" : "false")" />
                    </form>
                    
                    <div class="mt-3">
                        <div class="form-check">
                            <input type="checkbox" id="showOverdueOnly" class="form-check-input"
                                   @(ViewData["ShowOverdueOnly"]?.ToString() == "True" ? "checked" : "")>
                            <label class="form-check-label text-danger" for="showOverdueOnly">
                                <i class="fas fa-exclamation-triangle me-1"></i>Show overdue only
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Results -->
            @if (Model != null && Model.Any())
            {
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-list me-2"></i>
                            @Model.Count() Assessment(s) Found
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>
                                            <a asp-action="Index" 
                                               asp-route-sortOrder="@ViewData["NameSortParm"]"
                                               asp-route-searchString="@ViewData["CurrentFilter"]"
                                               asp-route-statusFilter="@ViewData["StatusFilter"]"
                                               asp-route-typeFilter="@ViewData["TypeFilter"]"
                                               asp-route-courseFilter="@ViewData["CourseFilter"]"
                                               asp-route-showOverdueOnly="@ViewData["ShowOverdueOnly"]"
                                               class="text-white text-decoration-none">
                                                Assessment <i class="fas fa-sort"></i>
                                            </a>
                                        </th>
                                        <th>Course</th>
                                        <th>Type</th>
                                        <th>
                                            <a asp-action="Index" 
                                               asp-route-sortOrder="@ViewData["DateSortParm"]"
                                               asp-route-searchString="@ViewData["CurrentFilter"]"
                                               asp-route-statusFilter="@ViewData["StatusFilter"]"
                                               asp-route-typeFilter="@ViewData["TypeFilter"]"
                                               asp-route-courseFilter="@ViewData["CourseFilter"]"
                                               asp-route-showOverdueOnly="@ViewData["ShowOverdueOnly"]"
                                               class="text-white text-decoration-none">
                                                Due Date <i class="fas fa-sort"></i>
                                            </a>
                                        </th>
                                        <th>
                                            <a asp-action="Index" 
                                               asp-route-sortOrder="@ViewData["StatusSortParm"]"
                                               asp-route-searchString="@ViewData["CurrentFilter"]"
                                               asp-route-statusFilter="@ViewData["StatusFilter"]"
                                               asp-route-typeFilter="@ViewData["TypeFilter"]"
                                               asp-route-courseFilter="@ViewData["CourseFilter"]"
                                               asp-route-showOverdueOnly="@ViewData["ShowOverdueOnly"]"
                                               class="text-white text-decoration-none">
                                                Status <i class="fas fa-sort"></i>
                                            </a>
                                        </th>
                                        <th>Score</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        var dueDateClass = item.IsOverdue ? "text-danger" :
                                        (item.DaysUntilDue <= 3 && item.DaysUntilDue >= 0) ? "text-warning" : "";

                                        <tr>
                                            <td>
                                                <div>
                                                    <strong>@item.Name</strong>
                                                    @if (!string.IsNullOrEmpty(item.Description))
                                                    {
                                                        <br>
                                            
                                                        <small class="text-muted">@item.Description.Substring(0, Math.Min(50, item.Description.Length))@(item.Description.Length > 50 ? "..." : "")</small>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                @if (item.Course != null)
                                                {
                                                    <strong>@item.Course.CourseNumber</strong>
                                        
                                                    <br>
                                                    <small class="text-muted">@item.Course.Title</small>
                                                }
                                                else
                                                {
                                                    <span class="text-danger">Course not found</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@item.Type</span>
                                            </td>
                                            <td class="@dueDateClass">
                                                <strong>@item.DueDate.ToString("MMM dd, yyyy")</strong><br>
                                                <small>
                                                    @if (item.IsOverdue)
                                                    {
                                                        <span class="text-danger">
                                                            <i class="fas fa-exclamation-triangle"></i> @Math.Abs(item.DaysUntilDue) days overdue
                                                        </span>
                                                    }
                                                    else if (item.DaysUntilDue == 0)
                                                    {
                                                        <span class="text-warning">
                                                            <i class="fas fa-clock"></i> Due today
                                                        </span>
                                                    }
                                                    else if (item.DaysUntilDue > 0)
                                                    {
                                                        <span class="text-muted">
                                                            <i class="fas fa-calendar-alt"></i> @item.DaysUntilDue days left
                                                        </span>
                                                    }
                                                </small>
                                            </td>
                                            <td>
                                                @{
                                                    var statusBadgeClass = item.Status switch
                                                    {
                                                        AssessmentStatus.Completed => "bg-success",
                                                        AssessmentStatus.InProgress => "bg-primary",
                                                        AssessmentStatus.Submitted => "bg-info",
                                                        AssessmentStatus.Graded => "bg-success",
                                                        _ => "bg-secondary"
                                                    };
                                                }
                                                <span class="badge @statusBadgeClass">@item.Status</span>
                                            </td>
                                            <td>
                                                @if (item.Score.HasValue)
                                                {
                                                    <strong>@item.Score.Value.ToString("F1")</strong>
                                        
                                                    <span class="text-muted">/@item.MaxPoints</span>
                                                    <br>

                                                    <small class="text-muted">(@((item.Score.Value / item.MaxPoints * 100).ToString("F1"))%)</small>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not graded</span>
                                                    <br>

                                                    <small class="text-muted">Max: @item.MaxPoints pts</small>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a asp-action="Details" asp-route-id="@item.Id"
                                                       class="btn btn-outline-info" title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                                       class="btn btn-outline-primary" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                                       class="btn btn-outline-danger" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-tasks fa-4x text-muted mb-3"></i>
                        <h5 class="text-muted mb-3">No Assessments Found</h5>
                        <p class="text-muted mb-4">
                            @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()) ||
                                                    !string.IsNullOrEmpty(ViewData["StatusFilter"]?.ToString()) ||
                                                    !string.IsNullOrEmpty(ViewData["TypeFilter"]?.ToString()) ||
                                                    !string.IsNullOrEmpty(ViewData["CourseFilter"]?.ToString()) ||
                                                    ViewData["ShowOverdueOnly"]?.ToString() == "True")
                            {
                                <text>No assessments match your current filters. Try adjusting your search criteria.</text>
                            }
                            else
                            {
                                <text>You don't have any assessments yet. Create your first assessment to get started!</text>
                            }
                        </p>
                        <div>
                            @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()) ||
                                                    !string.IsNullOrEmpty(ViewData["StatusFilter"]?.ToString()) ||
                                                    !string.IsNullOrEmpty(ViewData["TypeFilter"]?.ToString()) ||
                                                    !string.IsNullOrEmpty(ViewData["CourseFilter"]?.ToString()) ||
                                                    ViewData["ShowOverdueOnly"]?.ToString() == "True")
                            {
                                <a asp-action="Index" class="btn btn-outline-secondary me-2">
                                    <i class="fas fa-times me-1"></i>Clear Filters
                                </a>
                            }
                            <a asp-action="Create" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i>Create First Assessment
                            </a>
                            <a asp-action="Debug" class="btn btn-outline-info ms-2" target="_blank">
                                <i class="fas fa-bug me-1"></i>Debug Info
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Handle checkbox change for overdue filter
            $('#showOverdueOnly').change(function() {
                const isChecked = $(this).is(':checked');
                $('#showOverdueOnlyHidden').val(isChecked ? 'true' : 'false');
                $('#filterForm').submit();
            });

            // Auto-submit form when filters change (optional)
            $('#statusFilter, #typeFilter, #courseFilter, #sortOrder').change(function() {
                // Uncomment the next line to auto-submit on filter change
                // $('#filterForm').submit();
            });

            // Enhanced search functionality
            let searchTimeout;
            $('#searchString').on('input', function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(function() {
                    // Uncomment to enable auto-search
                    // $('#filterForm').submit();
                }, 500); // 500ms delay for better UX
            });

            // Clear filters functionality
            $('#clearFilters').click(function(e) {
                e.preventDefault();
                window.location.href = '@Url.Action("Index")';
            });
        });
    </script>
}