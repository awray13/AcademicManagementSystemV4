@model IEnumerable<AcademicManagementSystemV4.Models.Course>

@{
    ViewData["Title"] = "Academic Courses";
}

<div class="courses-container">
    <!-- Header Section -->
    <div class="courses-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="display-4">
                        <i class="fas fa-book me-3"></i>Academic Courses
                    </h1>
                    <p class="lead">Manage your courses and track your academic progress</p>
                </div>
                <div class="col-md-4 text-md-end">
                    <a asp-action="Create" class="btn btn-primary btn-lg">
                        <i class="fas fa-plus me-2"></i>Add New Course
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <!-- Statistics Cards -->
        @if (Model.Any())
        {
            <div class="row mb-4">
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card stats-card primary h-100">
                        <div class="card-body text-center">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="stats-number text-primary">@Model.Count()</div>
                                    <p class="stats-label">Total Courses</p>
                                </div>
                                <i class="fas fa-book fa-2x text-primary"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card stats-card success h-100">
                        <div class="card-body text-center">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="stats-number text-success">@Model.Count(c => c.EndDate < DateTime.Now)</div>
                                    <p class="stats-label">Completed</p>
                                </div>
                                <i class="fas fa-check-circle fa-2x text-success"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card stats-card warning h-100">
                        <div class="card-body text-center">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="stats-number text-warning">@Model.Count(c => c.StartDate <= DateTime.Now && c.EndDate >= DateTime.Now)</div>
                                    <p class="stats-label">Active</p>
                                </div>
                                <i class="fas fa-play-circle fa-2x text-warning"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card stats-card info h-100">
                        <div class="card-body text-center">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="stats-number text-info">@Model.Sum(c => c.CreditHours)</div>
                                    <p class="stats-label">Total Credits</p>
                                </div>
                                <i class="fas fa-graduation-cap fa-2x text-info"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Courses Table/Cards -->
        @if (Model.Any())
        {
            <div class="card courses-table">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-list me-2"></i>Your Academic Courses
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>
                                        <i class="fas fa-book me-1"></i>@Html.DisplayNameFor(model => model.Title)
                                    </th>
                                    <th>
                                        <i class="fas fa-hashtag me-1"></i>@Html.DisplayNameFor(model => model.CourseNumber)
                                    </th>
                                    <th>
                                        <i class="fas fa-calendar-alt me-1"></i>Term
                                    </th>
                                    <th>
                                        <i class="fas fa-calendar-plus me-1"></i>Start Date
                                    </th>
                                    <th>
                                        <i class="fas fa-calendar-minus me-1"></i>End Date
                                    </th>
                                    <th>
                                        <i class="fas fa-info-circle me-1"></i>Status
                                    </th>
                                    <th>
                                        <i class="fas fa-graduation-cap me-1"></i>Credits
                                    </th>
                                    <th class="text-center">
                                        <i class="fas fa-cogs me-1"></i>Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderByDescending(c => c.StartDate))
                                {
                                    var status = item.EndDate < DateTime.Now ? "completed" : 
                                               item.StartDate <= DateTime.Now && item.EndDate >= DateTime.Now ? "active" : "upcoming";
                                    var statusText = item.EndDate < DateTime.Now ? "Completed" : 
                                                   item.StartDate <= DateTime.Now && item.EndDate >= DateTime.Now ? "Active" : "Upcoming";
                                    var badgeClass = item.EndDate < DateTime.Now ? "status-completed" : 
                                                   item.StartDate <= DateTime.Now && item.EndDate >= DateTime.Now ? "status-active" : "status-upcoming";
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="me-3">
                                                    @if (status == "active")
                                                    {
                                                        <i class="fas fa-play-circle text-success fa-lg"></i>
                                                    }
                                                    else if (status == "upcoming")
                                                    {
                                                        <i class="fas fa-clock text-primary fa-lg"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fas fa-check-circle text-muted fa-lg"></i>
                                                    }
                                                </div>
                                                <div>
                                                    <div class="fw-bold">@Html.DisplayFor(modelItem => item.Title)</div>
                                                    @if (!string.IsNullOrEmpty(item.Description))
                                                    {
                                                        <small class="text-muted">@item.Description.Substring(0, Math.Min(50, item.Description.Length))...</small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@item.CourseNumber</span>
                                        </td>
                                        <td>
                                            <a asp-controller="Terms" asp-action="Details" asp-route-id="@item.TermId" class="text-decoration-none">
                                                @item.Term?.Name
                                            </a>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@item.StartDate.ToString("MMM dd, yyyy")</div>
                                            <small class="text-muted">@item.StartDate.ToString("dddd")</small>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@item.EndDate.ToString("MMM dd, yyyy")</div>
                                            <small class="text-muted">@item.EndDate.ToString("dddd")</small>
                                        </td>
                                        <td>
                                            <span class="status-badge @badgeClass">
                                                @statusText
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-info">@item.CreditHours</span>
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a asp-action="Details" asp-route-id="@item.Id" 
                                                   class="btn btn-outline-info" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@item.Id" 
                                                   class="btn btn-outline-primary" title="Edit Course">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" 
                                                   class="btn btn-outline-danger" title="Delete Course">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="card">
                <div class="card-body">
                    <div class="empty-state">
                        <i class="fas fa-book"></i>
                        <h3>No Courses Yet</h3>
                        <p>You haven't created any courses yet. Start by adding a course to track your academic progress.</p>
                        <a asp-action="Create" class="btn btn-primary btn-lg">
                            <i class="fas fa-plus me-2"></i>Create Your First Course
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/courses/courses.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/courses/courses.js" asp-append-version="true"></script>
}
