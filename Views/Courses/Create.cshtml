@model AcademicManagementSystemV4.Models.Course

@{
    ViewData["Title"] = "Create Course";
}

<div class="courses-container">
    <!-- Header Section -->
    <div class="courses-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="display-4">
                        <i class="fas fa-plus-circle me-3"></i>Create New Course
                    </h1>
                    <p class="lead text-muted">Add a new course to your academic plan</p>
                </div>
                <div class="col-md-4 text-md-end">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Courses
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <!-- Course Template Selection Card -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-template me-2"></i>Quick Course Creation
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info">
                            <i class="fas fa-lightbulb me-2"></i>
                            <strong>Quick Start:</strong> Select a course template to automatically create a course with predefined assessments and structure.
                        </div>
                        
                        <form asp-action="CreateFromTemplate" id="templateForm">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="fas fa-book me-1"></i>Course Template
                                    </label>
                                    <select name="courseTemplateId" class="form-select" id="courseTemplateSelect">
                                        <option value="">-- Select Course Template --</option>
                                        @foreach (var template in (ViewBag.CourseTemplates as SelectList)!)
                                        {
                                            <option value="@template.Value">@template.Text</option>
                                        }
                                    </select>
                                </div>
                                
                                <div class="col-md-3 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="fas fa-calendar me-1"></i>Term
                                    </label>
                                    <select name="termId" class="form-select" asp-items="ViewBag.TermId">
                                        <option value="">-- Select Term --</option>
                                    </select>
                                </div>
                                
                                <div class="col-md-2 mb-3">
                                    <label class="form-label fw-bold">Start Date</label>
                                    <input name="startDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                </div>
                                
                                <div class="col-md-2 mb-3">
                                    <label class="form-label fw-bold">End Date</label>
                                    <input name="endDate" type="date" class="form-control" value="@DateTime.Today.AddDays(120).ToString("yyyy-MM-dd")" />
                                </div>
                                
                                <div class="col-md-1 mb-3 d-flex align-items-end">
                                    <button type="submit" class="btn btn-success w-100" id="createFromTemplateBtn" disabled>
                                        <i class="fas fa-magic"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                        
                        <!-- Template Preview Area -->
                        <div id="templatePreview" class="mt-3" style="display: none;">
                            <div class="card border-info">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0">
                                        <i class="fas fa-eye me-2"></i>Template Preview
                                    </h6>
                                </div>
                                <div class="card-body" id="templatePreviewContent">
                                    <!-- Content will be loaded via AJAX -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- OR Divider -->
                <div class="text-center my-4">
                    <span class="badge bg-secondary fs-6 px-3 py-2">OR</span>
                </div>

                <!-- Manual Course Creation Card -->
                <div class="card shadow-sm">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-edit me-2"></i>Manual Course Creation
                        </h5>
                    </div>
                    <div class="card-body">
                        <!-- Your existing manual course creation form here -->
                        <form asp-action="Create" id="courseCreateForm">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                            
                            <!-- Basic Information Section -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h6 class="text-primary border-bottom pb-2 mb-3">
                                        <i class="fas fa-info-circle me-2"></i>Basic Information
                                    </h6>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <label asp-for="CourseNumber" class="form-label">
                                        <i class="fas fa-hashtag me-1"></i>Course Number *
                                    </label>
                                    <input asp-for="CourseNumber" class="form-control" placeholder="e.g., CS101" />
                                    <span asp-validation-for="CourseNumber" class="text-danger small"></span>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <label asp-for="CreditHours" class="form-label">
                                        <i class="fas fa-clock me-1"></i>Credit Hours *
                                    </label>
                                    <input asp-for="CreditHours" class="form-control" type="number" min="1" max="6" placeholder="3" />
                                    <span asp-validation-for="CreditHours" class="text-danger small"></span>
                                </div>
                                
                                <div class="col-12 mb-3">
                                    <label asp-for="Title" class="form-label">
                                        <i class="fas fa-book me-1"></i>Course Title *
                                    </label>
                                    <input asp-for="Title" class="form-control" placeholder="Enter course title" />
                                    <span asp-validation-for="Title" class="text-danger small"></span>
                                </div>
                                
                                <div class="col-12 mb-3">
                                    <label asp-for="Description" class="form-label">
                                        <i class="fas fa-align-left me-1"></i>Description
                                    </label>
                                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter course description (optional)"></textarea>
                                    <span asp-validation-for="Description" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- Schedule Information Section -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h6 class="text-primary border-bottom pb-2 mb-3">
                                        <i class="fas fa-calendar-alt me-2"></i>Schedule Information
                                    </h6>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <label asp-for="StartDate" class="form-label">
                                        <i class="fas fa-calendar-plus me-1"></i>Start Date *
                                    </label>
                                    <input asp-for="StartDate" class="form-control" type="date" />
                                    <span asp-validation-for="StartDate" class="text-danger small"></span>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <label asp-for="EndDate" class="form-label">
                                        <i class="fas fa-calendar-minus me-1"></i>End Date *
                                    </label>
                                    <input asp-for="EndDate" class="form-control" type="date" />
                                    <span asp-validation-for="EndDate" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- Assignment Information Section -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h6 class="text-primary border-bottom pb-2 mb-3">
                                        <i class="fas fa-cog me-2"></i>Assignment Information
                                    </h6>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Status" class="form-label">
                                        <i class="fas fa-flag me-1"></i>Status *
                                    </label>
                                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<CourseStatus>()">
                                        <option value="">-- Select Status --</option>
                                    </select>
                                    <span asp-validation-for="Status" class="text-danger small"></span>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <label asp-for="TermId" class="form-label">
                                        <i class="fas fa-calendar me-1"></i>Term *
                                    </label>
                                    <select asp-for="TermId" class="form-select" asp-items="ViewBag.TermId">
                                        <option value="">-- Select Term --</option>
                                    </select>
                                    <span asp-validation-for="TermId" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- Hidden Fields -->
                            <input type="hidden" asp-for="CreatedAt" />
                            <input type="hidden" asp-for="UpdatedAt" />

                            <!-- Action Buttons -->
                            <div class="d-flex justify-content-between border-top pt-3">
                                <a asp-action="Index" class="btn btn-outline-secondary">
                                    <i class="fas fa-times me-2"></i>Cancel
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save me-2"></i>Create Course
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const templateSelect = document.getElementById('courseTemplateSelect');
    const createBtn = document.getElementById('createFromTemplateBtn');
    const preview = document.getElementById('templatePreview');
    
    templateSelect.addEventListener('change', function() {
        const templateId = this.value;
        createBtn.disabled = !templateId;
        
        if (templateId) {
            // Load template preview via AJAX
            fetch(`/api/course-templates/${templateId}/preview`)
                .then(response => response.json())
                .then(data => {
                    document.getElementById('templatePreviewContent').innerHTML = `
                        <h6>${data.courseNumber} - ${data.title}</h6>
                        <p class="text-muted">${data.description}</p>
                        <p><strong>Credit Hours:</strong> ${data.creditHours}</p>
                        <p><strong>Included Assessments (${data.assessments.length}):</strong></p>
                        <ul class="list-group list-group-flush">
                            ${data.assessments.map(a => `
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>${a.name} (${a.type})</span>
                                    <span class="badge bg-primary">${a.maxPoints} pts</span>
                                </li>
                            `).join('')}
                        </ul>
                    `;
                    preview.style.display = 'block';
                })
                .catch(() => {
                    preview.style.display = 'none';
                });
        } else {
            preview.style.display = 'none';
        }
    });
});
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            // Auto-set current date for start date if empty
            if ($('#StartDate').val() === '') {
                $('#StartDate').val(new Date().toISOString().split('T')[0]);
            }
            
            // Validate end date is after start date
            $('#StartDate, #EndDate').on('change', function() {
                const startDate = new Date($('#StartDate').val());
                const endDate = new Date($('#EndDate').val());
                
                if (startDate && endDate && endDate <= startDate) {
                    $('#EndDate')[0].setCustomValidity('End date must be after start date');
                } else {
                    $('#EndDate')[0].setCustomValidity('');
                }
            });
        });
    </script>
}

@section Styles {
    <style>
        .courses-header {
            background: linear-gradient(135deg, #6c5ce7 0%, #74b9ff 100%);
            color: white;
            padding: 2rem 0;
            margin-bottom: 2rem;
        }
        .form-label {
            font-weight: 600;
            color: #495057;
        }
        .card {
            border: none;
            border-radius: 10px;
        }
        .card-header {
            border-radius: 10px 10px 0 0 !important;
        }
    </style>
}
