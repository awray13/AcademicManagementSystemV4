@model AcademicManagementSystemV4.Models.Term

@{
    ViewData["Title"] = "Term Details";
}

<div class="terms-container">
    <!-- Header Section -->
    <div class="terms-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="display-4">
                        <i class="fas fa-calendar-alt me-3"></i>@Model.Name
                    </h1>
                    <p class="lead">
                        @if (Model.EndDate < DateTime.Now)
                        {
                            <span class="badge bg-secondary">Completed</span>
                        }
                        else if (Model.StartDate <= DateTime.Now && Model.EndDate >= DateTime.Now)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-info">Upcoming</span>
                        }
                        <span class="ms-2">@Model.StartDate.ToString("MMM dd, yyyy") - @Model.EndDate.ToString("MMM dd, yyyy")</span>
                    </p>
                </div>
                <div class="col-md-4 text-md-end">
                    <div class="btn-group">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="fas fa-edit me-2"></i>Edit Term
                        </a>
                        <a asp-action="Index" class="btn btn-outline-primary">
                            <i class="fas fa-arrow-left me-2"></i>Back to Terms
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <!-- Term Information -->
        <div class="row mb-4">
            <div class="col-md-8">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-info-circle me-2"></i>Term Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-3 fw-bold">
                                <i class="fas fa-calendar-plus me-2"></i>Start Date:
                            </div>
                            <div class="col-md-9">
                                @Model.StartDate.ToString("MMMM dd, yyyy") (@Model.StartDate.ToString("dddd"))
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-3 fw-bold">
                                <i class="fas fa-calendar-minus me-2"></i>End Date:
                            </div>
                            <div class="col-md-9">
                                @Model.EndDate.ToString("MMMM dd, yyyy") (@Model.EndDate.ToString("dddd"))
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-3 fw-bold">
                                <i class="fas fa-hourglass-half me-2"></i>Duration:
                            </div>
                            <div class="col-md-9">
                                @((Model.EndDate - Model.StartDate).TotalDays.ToString("F0")) days 
                                (@Math.Ceiling((Model.EndDate - Model.StartDate).TotalDays / 7).ToString("F0") weeks)
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-3 fw-bold">
                                <i class="fas fa-align-left me-2"></i>Description:
                            </div>
                            <div class="col-md-9">
                                @if (string.IsNullOrEmpty(Model.Description))
                                {
                                    <span class="text-muted fst-italic">No description provided</span>
                                }
                                else
                                {
                                    @Model.Description
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-chart-bar me-2"></i>Term Statistics
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="stat-item mb-3">
                            <div class="fw-bold text-primary mb-1">
                                <i class="fas fa-book me-2"></i>Courses
                            </div>
                            <h3>@(Model.Courses?.Count() ?? 0)</h3>
                        </div>
                        
                        <div class="stat-item mb-3">
                            <div class="fw-bold text-primary mb-1">
                                <i class="fas fa-clock me-2"></i>Status
                            </div>
                            <h3>
                                @if (Model.EndDate < DateTime.Now)
                                {
                                    <span class="text-secondary">Completed</span>
                                }
                                else if (Model.StartDate <= DateTime.Now && Model.EndDate >= DateTime.Now)
                                {
                                    <span class="text-success">Active</span>
                                }
                                else
                                {
                                    <span class="text-info">Upcoming</span>
                                }
                            </h3>
                        </div>
                        
                        <div class="stat-item">
                            <div class="fw-bold text-primary mb-1">
                                <i class="fas fa-calendar me-2"></i>Days Remaining
                            </div>
                            <h3>
                                @if (Model.EndDate < DateTime.Now)
                                {
                                    <span class="text-secondary">0</span>
                                }
                                else if (Model.EndDate >= DateTime.Now)
                                {
                                    <span>@((Model.EndDate - DateTime.Now).TotalDays.ToString("F0"))</span>
                                }
                            </h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Course List Section -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    <i class="fas fa-book me-2"></i>Term Courses
                </h5>
                <a asp-controller="Courses" asp-action="Create" asp-route-termId="@Model.Id" class="btn btn-sm btn-light">
                    <i class="fas fa-plus me-1"></i>Add Course
                </a>
            </div>
            <div class="card-body p-0">
                @if (Model.Courses != null && Model.Courses.Any())
                {
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Course Name</th>
                                    <th>Course Number</th>
                                    <th>Credit Hours</th>
                                    <th>Status</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var course in Model.Courses)
                                {
                                    <tr>
                                        <td>@course.Title</td>
                                        <td>@course.CourseNumber</td>
                                        <td>@course.CreditHours</td>
                                        <td>
                                            <span class="badge bg-success">Active</span>
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id" class="btn btn-outline-info" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-controller="Courses" asp-action="Edit" asp-route-id="@course.Id" class="btn btn-outline-primary" title="Edit Course">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-controller="Courses" asp-action="Delete" asp-route-id="@course.Id" class="btn btn-outline-danger" title="Delete Course">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center p-5">
                        <i class="fas fa-book-open fa-3x text-muted mb-3"></i>
                        <h5>No Courses Yet</h5>
                        <p class="text-muted">This term doesn't have any courses assigned yet.</p>
                        <a asp-controller="Courses" asp-action="Create" asp-route-termId="@Model.Id" class="btn btn-primary mt-2">
                            <i class="fas fa-plus me-2"></i>Add First Course
                        </a>
                    </div>
                }
            </div>
        </div>
        
        <!-- Action Buttons -->
        <div class="d-flex justify-content-between mb-4">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Terms
            </a>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary me-2">
                    <i class="fas fa-edit me-2"></i>Edit Term
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                    <i class="fas fa-trash me-2"></i>Delete Term
                </a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/terms/terms.css" asp-append-version="true" />
}
