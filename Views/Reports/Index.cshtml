@model AcademicManagementSystemV4.Models.ViewModels.ReportsIndexViewModel

@{
    ViewData["Title"] = "Academic Report";
}

<div class="reports-container">
    <!-- Header Section -->
    <div class="reports-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="display-4">
                        <i class="fas fa-chart-bar me-3"></i>Academic Report
                    </h1>
                    <p class="lead text-light">
                        Comprehensive overview of your academic progress
                    </p>
                </div>
                <div class="col-md-4 text-md-end">
                    <div class="btn-group">
                        <button type="button" class="btn btn-outline-light" onclick="generateReport()">
                            <i class="fas fa-sync-alt me-2"></i>Refresh Report
                        </button>
                        <button type="button" class="btn btn-light" onclick="downloadCSV()">
                            <i class="fas fa-download me-2"></i>Download CSV
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-12">
                <!-- Report Card -->
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0">
                                <i class="fas fa-file-alt me-2"></i>Comprehensive Academic Report
                            </h5>
                            <small class="text-light">
                                Last updated: <span id="lastUpdated">@DateTime.Now.ToString("MMM dd, yyyy HH:mm")</span>
                            </small>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- Loading State -->
                        <div id="reportLoading" class="text-center py-5" style="display: none;">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading report...</span>
                            </div>
                            <p class="mt-3 text-muted">Generating your academic report...</p>
                        </div>

                        <!-- Report Content -->
                        <div id="reportContent">
                            <!-- Summary Section -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h6 class="text-primary border-bottom pb-2 mb-3">
                                        <i class="fas fa-chart-pie me-2"></i>Academic Summary
                                    </h6>
                                    <div class="row g-3" id="summaryStats">
                                        <!-- Stats will be populated here -->
                                    </div>
                                </div>
                            </div>

                            <!-- Terms Section -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h6 class="text-primary border-bottom pb-2 mb-3">
                                        <i class="fas fa-calendar me-2"></i>Terms Overview
                                    </h6>
                                    <div class="table-responsive">
                                        <table class="table table-striped table-hover" id="termsTable">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>Term Name</th>
                                                    <th>Period</th>
                                                    <th>Courses Count</th>
                                                    <th>Status</th>
                                                    <th>Progress</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <!-- Terms data will be populated here -->
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Courses Section -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h6 class="text-primary border-bottom pb-2 mb-3">
                                        <i class="fas fa-book me-2"></i>Courses Details
                                    </h6>
                                    <div class="table-responsive">
                                        <table class="table table-striped table-hover" id="coursesTable">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>Course Number</th>
                                                    <th>Title</th>
                                                    <th>Term</th>
                                                    <th>Credit Hours</th>
                                                    <th>Status</th>
                                                    <th>Progress</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <!-- Courses data will be populated here -->
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Assessments Section -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h6 class="text-primary border-bottom pb-2 mb-3">
                                        <i class="fas fa-tasks me-2"></i>Assessments Overview
                                    </h6>
                                    <div class="table-responsive">
                                        <table class="table table-striped table-hover" id="assessmentsTable">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>Assessment Name</th>
                                                    <th>Course</th>
                                                    <th>Type</th>
                                                    <th>Due Date</th>
                                                    <th>Status</th>
                                                    <th>Score</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <!-- Assessments data will be populated here -->
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Export Note -->
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle me-2"></i>
                                <strong>Export Options:</strong> You can download this report as a CSV file for further analysis in Excel or other spreadsheet applications.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Report data storage
        let reportData = {
            terms: [],
            courses: [],
            assessments: [],
            summary: {}
        };

        // Initialize report on page load
        $(document).ready(function() {
            generateReport();
        });

        // Generate/refresh report
        async function generateReport() {
            showLoading(true);
            
            try {
                const response = await fetch('@Url.Action("GetReportData")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    }
                });

                if (!response.ok) {
                    throw new Error('Failed to generate report');
                }

                reportData = await response.json();
                populateReport();
                updateLastUpdated();
                
            } catch (error) {
                console.error('Error generating report:', error);
                showError('Failed to generate report. Please try again.');
            } finally {
                showLoading(false);
            }
        }

        // Show/hide loading state
        function showLoading(show) {
            $('#reportLoading').toggle(show);
            $('#reportContent').toggle(!show);
        }

        // Populate report sections
        function populateReport() {
            populateSummary();
            populateTerms();
            populateCourses();
            populateAssessments();
        }

        // Populate summary statistics
        function populateSummary() {
            const summary = reportData.summary;
            const summaryHtml = `
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card border-primary bg-light h-100">
                        <div class="card-body text-center">
                            <h4 class="text-primary mb-1">${summary.totalTerms || 0}</h4>
                            <p class="card-text mb-0">Total Terms</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card border-success bg-light h-100">
                        <div class="card-body text-center">
                            <h4 class="text-success mb-1">${summary.totalCourses || 0}</h4>
                            <p class="card-text mb-0">Total Courses</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card border-info bg-light h-100">
                        <div class="card-body text-center">
                            <h4 class="text-info mb-1">${summary.totalAssessments || 0}</h4>
                            <p class="card-text mb-0">Total Assessments</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card border-warning bg-light h-100">
                        <div class="card-body text-center">
                            <h4 class="text-warning mb-1">${summary.totalCreditHours || 0}</h4>
                            <p class="card-text mb-0">Credit Hours</p>
                        </div>
                    </div>
                </div>
            `;
            $('#summaryStats').html(summaryHtml);
        }

        // Populate terms table
        function populateTerms() {
            const tbody = $('#termsTable tbody');
            tbody.empty();

            reportData.terms.forEach(term => {
                const row = `
                    <tr>
                        <td>${term.name}</td>
                        <td>${formatDate(term.startDate)} - ${formatDate(term.endDate)}</td>
                        <td><span class="badge bg-secondary">${term.coursesCount}</span></td>
                        <td><span class="badge bg-${getStatusColor(term.status)}">${term.status}</span></td>
                        <td>
                            <div class="progress" style="height: 20px;">
                                <div class="progress-bar" role="progressbar" style="width: ${term.progress}%">${term.progress}%</div>
                            </div>
                        </td>
                    </tr>
                `;
                tbody.append(row);
            });
        }

        // Populate courses table
        function populateCourses() {
            const tbody = $('#coursesTable tbody');
            tbody.empty();

            reportData.courses.forEach(course => {
                const row = `
                    <tr>
                        <td><strong>${course.courseNumber}</strong></td>
                        <td>${course.title}</td>
                        <td>${course.termName}</td>
                        <td><span class="badge bg-primary">${course.creditHours}</span></td>
                        <td><span class="badge bg-${getStatusColor(course.status)}">${course.status}</span></td>
                        <td>
                            <div class="progress" style="height: 20px;">
                                <div class="progress-bar" role="progressbar" style="width: ${course.completionPercentage}%">${course.completionPercentage}%</div>
                            </div>
                        </td>
                    </tr>
                `;
                tbody.append(row);
            });
        }

        // Populate assessments table
        function populateAssessments() {
            const tbody = $('#assessmentsTable tbody');
            tbody.empty();

            reportData.assessments.forEach(assessment => {
                const row = `
                    <tr>
                        <td>${assessment.name}</td>
                        <td>${assessment.courseName}</td>
                        <td><span class="badge bg-info">${assessment.type}</span></td>
                        <td>${formatDate(assessment.dueDate)}</td>
                        <td><span class="badge bg-${getStatusColor(assessment.status)}">${assessment.status}</span></td>
                        <td>${assessment.score ? assessment.score.toFixed(1) + '%' : 'N/A'}</td>
                    </tr>
                `;
                tbody.append(row);
            });
        }

        // Download CSV
        function downloadCSV() {
            try {
                const csv = generateCSV();
                const blob = new Blob([csv], { type: 'text/csv' });
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = url;
                a.download = `Academic_Report_${new Date().toISOString().slice(0, 10)}.csv`;
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                document.body.removeChild(a);
                
                showSuccess('CSV file downloaded successfully!');
            } catch (error) {
                console.error('Error downloading CSV:', error);
                showError('Failed to download CSV file.');
            }
        }

        // Generate CSV content
        function generateCSV() {
            let csv = '';
            
            // Add Terms section
            csv += 'TERMS\n';
            csv += 'Term Name,Start Date,End Date,Courses Count,Status,Progress\n';
            reportData.terms.forEach(term => {
                csv += `"${term.name}","${formatDate(term.startDate)}","${formatDate(term.endDate)}","${term.coursesCount}","${term.status}","${term.progress}%"\n`;
            });
            csv += '\n';

            // Add Courses section
            csv += 'COURSES\n';
            csv += 'Course Number,Title,Term,Credit Hours,Status,Completion %\n';
            reportData.courses.forEach(course => {
                csv += `"${course.courseNumber}","${course.title}","${course.termName}","${course.creditHours}","${course.status}","${course.completionPercentage}%"\n`;
            });
            csv += '\n';

            // Add Assessments section
            csv += 'ASSESSMENTS\n';
            csv += 'Assessment Name,Course,Type,Due Date,Status,Score\n';
            reportData.assessments.forEach(assessment => {
                const score = assessment.score ? assessment.score.toFixed(1) + '%' : 'N/A';
                csv += `"${assessment.name}","${assessment.courseName}","${assessment.type}","${formatDate(assessment.dueDate)}","${assessment.status}","${score}"\n`;
            });

            return csv;
        }

        // Utility functions
        function formatDate(dateString) {
            return new Date(dateString).toLocaleDateString();
        }

        function getStatusColor(status) {
            switch(status?.toLowerCase()) {
                case 'completed': return 'success';
                case 'active': case 'in progress': return 'primary';
                case 'pending': return 'warning';
                case 'cancelled': case 'failed': return 'danger';
                default: return 'secondary';
            }
        }

        function updateLastUpdated() {
            $('#lastUpdated').text(new Date().toLocaleString());
        }

        function showSuccess(message) {
            // You can implement a toast notification here
            console.log('Success:', message);
        }

        function showError(message) {
            // You can implement a toast notification here
            console.error('Error:', message);
            alert(message);
        }
    </script>
}

@section Styles {
    <style>
        .reports-header {
            background: linear-gradient(135deg, #6c5ce7 0%, #74b9ff 100%);
            color: white;
            padding: 2rem 0;
            margin-bottom: 2rem;
        }
        
        .card {
            border: none;
            border-radius: 10px;
        }
        
        .card-header {
            border-radius: 10px 10px 0 0 !important;
        }
        
        .table th {
            font-weight: 600;
            font-size: 0.9rem;
        }
        
        .progress {
            border-radius: 10px;
        }
        
        .progress-bar {
            border-radius: 10px;
        }
        
        .report-card:hover {
            transform: translateY(-2px);
            transition: transform 0.2s ease;
        }
    </style>
}

<!-- Add anti-forgery token for AJAX requests -->
@Html.AntiForgeryToken()
