@using AcademicManagementSystemV4.Models.ViewModels
@model RegisterViewModel

@{
    ViewData["Title"] = "Create Account";
}

<div class="register-container">
    <!-- Header Section -->
    <div class="register-header bg-primary text-white py-4 mb-4">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="display-4">
                        <i class="fas fa-user-plus me-3"></i>Create Your Account
                    </h1>
                    <p class="lead">
                        Join our Academic Management System to track your academic progress
                    </p>
                </div>
                <div class="col-md-4 text-md-end">
                    <a asp-action="Login" class="btn btn-outline-light">
                        <i class="fas fa-sign-in-alt me-2"></i>Already have an account?
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-user-circle me-2"></i>Registration Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <!-- Display validation summary -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <!-- Registration Form -->
                        <form asp-action="Register" method="post" id="registerForm">
                            
                            <!-- Personal Information Section -->
                            <fieldset class="mb-4">
                                <legend class="h6 text-success border-bottom pb-2 mb-3">
                                    <i class="fas fa-user me-2"></i>Personal Information
                                </legend>
                                
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="FirstName" class="form-label">
                                            <i class="fas fa-user me-1"></i>First Name *
                                        </label>
                                        <input asp-for="FirstName" class="form-control" placeholder="Enter your first name" />
                                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                                    </div>
                                    
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="LastName" class="form-label">
                                            <i class="fas fa-user me-1"></i>Last Name *
                                        </label>
                                        <input asp-for="LastName" class="form-control" placeholder="Enter your last name" />
                                        <span asp-validation-for="LastName" class="text-danger small"></span>
                                    </div>
                                </div>
                                
                                <div class="row">
                                    <div class="col-md-8 mb-3">
                                        <label asp-for="Email" class="form-label">
                                            <i class="fas fa-envelope me-1"></i>Email Address *
                                        </label>
                                        <input asp-for="Email" class="form-control" placeholder="Enter your email address" />
                                        <span asp-validation-for="Email" class="text-danger small"></span>
                                        <div id="email-availability" class="mt-1" style="display: none;"></div>
                                        <div class="form-text">
                                            <i class="fas fa-info-circle me-1"></i>We accept educational (.edu) and major email providers
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-4 mb-3">
                                        <label asp-for="PhoneNumber" class="form-label">
                                            <i class="fas fa-phone me-1"></i>Phone Number
                                        </label>
                                        <input asp-for="PhoneNumber" class="form-control" placeholder="(Optional)" />
                                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                    </div>
                                </div>
                            </fieldset>

                            <!-- Password Section -->
                            <fieldset class="mb-4">
                                <legend class="h6 text-success border-bottom pb-2 mb-3">
                                    <i class="fas fa-lock me-2"></i>Password & Security
                                </legend>
                                
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Password" class="form-label">
                                            <i class="fas fa-key me-1"></i>Password *
                                        </label>
                                        <div class="input-group">
                                            <input asp-for="Password" type="password" class="form-control" placeholder="Create a strong password" />
                                            <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('Password')">
                                                <i class="fas fa-eye" id="Password-toggle-icon"></i>
                                            </button>
                                        </div>
                                        <span asp-validation-for="Password" class="text-danger small"></span>
                                        
                                        <!-- Client-side password strength indicator -->
                                        <div class="mt-2">
                                            <div class="progress" style="height: 5px;">
                                                <div id="password-strength" class="progress-bar" role="progressbar" style="width: 0%"></div>
                                            </div>
                                            <small id="password-strength-text" class="text-muted">Password strength will appear here</small>
                                        </div>
                                        
                                        <!-- Server-side password strength indicator (fallback) -->
                                        @if (!string.IsNullOrEmpty(Model.Password))
                                        {
                                            var strength = Model.PasswordStrengthLevel;
                                            var strengthClass = strength switch
                                            {
                                                PasswordStrength.Strong => "success",
                                                PasswordStrength.Good => "info", 
                                                PasswordStrength.Fair => "warning",
                                                _ => "danger"
                                            };
                                            
                                            <div class="mt-2">
                                                <div class="progress" style="height: 5px;">
                                                    <div class="progress-bar bg-@strengthClass" role="progressbar" 
                                                         style="width: @((int)strength * 25)%"></div>
                                                </div>
                                                <small class="text-@strengthClass">Password strength: @strength</small>
                                            </div>
                                        }
                                    </div>
                                    
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="ConfirmPassword" class="form-label">
                                            <i class="fas fa-check-double me-1"></i>Confirm Password *
                                        </label>
                                        <div class="input-group">
                                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm your password" />
                                            <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('ConfirmPassword')">
                                                <i class="fas fa-eye" id="ConfirmPassword-toggle-icon"></i>
                                            </button>
                                        </div>
                                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                        <div id="password-match" class="mt-1" style="display: none;"></div>
                                    </div>
                                </div>
                            </fieldset>

                            <!-- Password Requirements -->
                            <div class="alert alert-info mb-4">
                                <h6><i class="fas fa-shield-alt me-2"></i>Password Requirements:</h6>
                                <div class="row">
                                    <div class="col-md-6">
                                        <ul class="mb-0 small">
                                            <li id="req-length" class="text-muted">At least 8 characters</li>
                                            <li id="req-uppercase" class="text-muted">One uppercase letter</li>
                                            <li id="req-lowercase" class="text-muted">One lowercase letter</li>
                                        </ul>
                                    </div>
                                    <div class="col-md-6">
                                        <ul class="mb-0 small">
                                            <li id="req-number" class="text-muted">One number</li>
                                            <li id="req-special" class="text-muted">One special character</li>
                                            <li class="text-muted">Different from personal info</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <!-- Terms and Preferences -->
                            <fieldset class="mb-4">
                                <legend class="h6 text-success border-bottom pb-2 mb-3">
                                    <i class="fas fa-cog me-2"></i>Terms & Preferences
                                </legend>
                                
                                <div class="mb-3">
                                    <div class="form-check">
                                        <input asp-for="AgreeToTerms" class="form-check-input" />
                                        <label asp-for="AgreeToTerms" class="form-check-label">
                                            I agree to the <a href="#" data-bs-toggle="modal" data-bs-target="#termsModal">Terms and Conditions</a> and <a href="#" data-bs-toggle="modal" data-bs-target="#privacyModal">Privacy Policy</a> *
                                        </label>
                                    </div>
                                    <span asp-validation-for="AgreeToTerms" class="text-danger small"></span>
                                </div>
                                
                                <div class="mb-3">
                                    <div class="form-check">
                                        <input asp-for="SubscribeToNewsletter" class="form-check-input" />
                                        <label asp-for="SubscribeToNewsletter" class="form-check-label">
                                            <i class="fas fa-envelope me-1"></i>Subscribe to academic news and updates (optional)
                                        </label>
                                    </div>
                                </div>
                            </fieldset>

                            <!-- Hidden Fields -->
                            <input type="hidden" asp-for="ReturnUrl" />

                            <!-- Action Buttons -->
                            <div class="d-flex justify-content-between">
                                <div>
                                    <a asp-action="Login" class="btn btn-outline-secondary">
                                        <i class="fas fa-sign-in-alt me-2"></i>Already have an account?
                                    </a>
                                </div>
                                <button type="submit" id="registerBtn" class="btn btn-success btn-lg">
                                    <i class="fas fa-user-plus me-2"></i>Create Account
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Loading Overlay -->
<div id="loadingOverlay" class="loading-overlay" style="display: none;">
    <div class="loading-content">
        <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3 text-white">Creating your account...</p>
    </div>
</div>

<!-- Keep the modals for terms and privacy -->
<!-- Terms Modal -->
<div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="termsModalLabel">Terms and Conditions</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <h6>Academic Management System - Terms of Service</h6>
                <p>By creating an account, you agree to:</p>
                <ul>
                    <li>Provide accurate and truthful information</li>
                    <li>Keep your account credentials secure</li>
                    <li>Use the system for educational purposes only</li>
                    <li>Respect the privacy of other users</li>
                    <li>Not attempt to hack or compromise the system</li>
                </ul>
                <p><strong>Account Security:</strong> You are responsible for maintaining the confidentiality of your account information.</p>
                <p><strong>Data Usage:</strong> Your academic data will be used solely for providing educational management services.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Privacy Policy Modal -->
<div class="modal fade" id="privacyModal" tabindex="-1" aria-labelledby="privacyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="privacyModalLabel">Privacy Policy</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <h6>Your Privacy Matters</h6>
                <p><strong>Information We Collect:</strong></p>
                <ul>
                    <li>Name and contact information you provide</li>
                    <li>Academic progress and course data you enter</li>
                    <li>System usage patterns for improvement purposes</li>
                </ul>
                <p><strong>How We Use Your Information:</strong></p>
                <ul>
                    <li>To provide academic management services</li>
                    <li>To improve our platform and user experience</li>
                    <li>To send important account notifications</li>
                </ul>
                <p><strong>Data Security:</strong> We use industry-standard encryption and security measures to protect your data.</p>
                <p><strong>Data Sharing:</strong> We do not sell or share your personal information with third parties.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/account/register.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/account/register.css" asp-append-version="true" />
}
